generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Recept {
  id              Int           @id @default(autoincrement())
  slug            String        @unique
  titel           String
  categorie       Categorie
  porties         Int?
  bereidingstijd  Int?          // in minuten
  beoordeling     Int?          // 1-5
  herkomstNaam    String?
  herkomstUrl     String?
  ingebrachtDoor  String?       // null = Joost, anders naam indiener voorstel
  goedgekeurd     Boolean       @default(true) // false = wacht op goedkeuring
  voorstelNaam    String?       // naam + bericht van indiener (alleen bij voorstellen)
  voorstelBericht String?
  benodigdheden   String[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  ingredienten    Ingredient[]
  stappen         Stap[]
  fotos           Foto[]
  tags            ReceptTag[]
  opmerkingen     Opmerking[]
  weekItem        WeekItem?
  weekGeschiedenis WeekGeschiedenis[]
}

model Ingredient {
  id          Int     @id @default(autoincrement())
  volgorde    Int
  hoeveelheid Float?
  eenheid     String?
  naam        String
  notitie     String?
  receptId    Int
  recept      Recept  @relation(fields: [receptId], references: [id], onDelete: Cascade)

  // Regel zoals binnengekomen; wordt daarna nooit overschreven
  oorspronkelijkeTekst String?
  productId            Int?
  product              Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([productId])
}

model Product {
  id           Int      @id @default(autoincrement())
  naam         String   @unique // Nederlands, enkelvoud, kleine letters
  afdeling     String   // code uit lib/afdelingen.ts
  altijdInHuis Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  synoniemen   ProductSynoniem[]
  ingredienten Ingredient[]
}

model ProductSynoniem {
  id        Int     @id @default(autoincrement())
  tekst     String  @unique // genormaliseerd: meervoud, Engelse naam, spelvariant
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// Het mandje: de recepten die je deze week eet.
model WeekItem {
  id        Int      @id @default(autoincrement())
  receptId  Int      @unique // een recept staat maximaal één keer in het mandje
  recept    Recept   @relation(fields: [receptId], references: [id], onDelete: Cascade)
  porties   Int?     // gekozen porties; null = recept heeft geen porties (factor 1)
  createdAt DateTime @default(now())
}

// "Nieuwe week" bewaart hier de recepten van die week.
model WeekGeschiedenis {
  id          Int      @id @default(autoincrement())
  afgerondOp  DateTime @default(now()) // alle regels van één "Nieuwe week" delen dezelfde waarde
  receptId    Int?
  recept      Recept?  @relation(fields: [receptId], references: [id], onDelete: SetNull)
  receptTitel String   // kopie van de titel, voor als het recept later wordt verwijderd
  porties     Int?

  @@index([afgerondOp])
}

// Eigen regels op de boodschappenlijst ("wc-papier").
model LijstRegel {
  id        Int      @id @default(autoincrement())
  tekst     String
  createdAt DateTime @default(now())
}

// Een vinkje op de boodschappenlijst: de rij bestaat = afgevinkt. De sleutel hoort
// bij een lijstregel (zie lib/boodschappenlijst.ts) en blijft gelijk als porties of
// recepten veranderen. Bewust geen relaties.
model LijstVink {
  sleutel   String   @id
  createdAt DateTime @default(now())
}

model Stap {
  id       Int    @id @default(autoincrement())
  volgorde Int
  tekst    String
  receptId Int
  recept   Recept @relation(fields: [receptId], references: [id], onDelete: Cascade)
}

model Foto {
  id       Int    @id @default(autoincrement())
  volgorde Int
  url      String
  altTekst String?
  receptId Int
  recept   Recept @relation(fields: [receptId], references: [id], onDelete: Cascade)
}

model Opmerking {
  id        Int      @id @default(autoincrement())
  naam      String
  bericht   String
  sterren   Int?     // 1-5, optioneel
  fotoUrl   String?  // optioneel
  receptId  Int
  recept    Recept   @relation(fields: [receptId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Tag {
  id      Int         @id @default(autoincrement())
  naam    String      @unique
  recepten ReceptTag[]
}

model ReceptTag {
  receptId Int
  tagId    Int
  recept   Recept @relation(fields: [receptId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([receptId, tagId])
}

model VoorgesteldRecept {
  id          Int            @id @default(autoincrement())
  naam        String
  bericht     String
  receptData  Json
  status      VoorstelStatus @default(WACHT)
  createdAt   DateTime       @default(now())
}

enum VoorstelStatus {
  WACHT
  GOEDGEKEURD
  AFGEWEZEN
}

model ImportMelding {
  id        Int      @id @default(autoincrement())
  url       String
  naam      String?  // naam van indiener (optioneel)
  bron      String   // "voorstellen" of "admin"
  createdAt DateTime @default(now())
}

enum Categorie {
  PASTA
  CURRY
  SOEP
  SALADE
  RIJST_EN_GRANEN
  VLEES
  VIS_EN_ZEEVRUCHTEN
  GROENTEN
  SNACKS
  ONTBIJT
  DESSERT
  SAUZEN
  OVERIG
}
